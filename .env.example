# Copy to .env and adjust as needed. Never commit .env.

APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# AI insights provider: "demo" (default, rule-based, no external calls) or "openai".
AI_PROVIDER=demo

# Only used when AI_PROVIDER=openai. Keep this value on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
